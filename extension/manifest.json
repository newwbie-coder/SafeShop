{
  "manifest_version": 3,
  "name": "Safe Shop",
  "version": "1.0",

  "permissions": ["activeTab", "scripting"],

  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["*://*.bigbasket.com/*"],
      "js": ["content.js"]
    }
  ]
}